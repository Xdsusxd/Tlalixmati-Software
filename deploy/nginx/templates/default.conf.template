# Configuración de Nginx para Tlalixmati en Producción
# Enruta dominio web hacia Frontend (Next.js :3000) y API (FastAPI :8000)

upstream frontend_servidor {
    server web:3000;
    keepalive 32;
}

upstream backend_servidor {
    server api:8000;
    keepalive 32;
}

# Redirección HTTP hacia HTTPS y verificación Let's Encrypt
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME} localhost;

    # Desafío ACME para certificados SSL con Certbot / Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Si se habilitó SSL, redirigir todo el tráfico HTTP a HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# Servidor HTTPS de Producción
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME};

    # Certificados SSL / TLS
    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    # Parámetros de seguridad TLS modernos
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Encabezados de seguridad HTTP
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Tamaño máximo de subida para fotos y reportes
    client_max_body_size 30M;

    # 1. Enrutamiento del Backend API (FastAPI)
    location /api/ {
        proxy_pass http://backend_servidor;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
    }

    # 2. Configuración especial para Streaming en Vivo de la Cámara (MJPEG)
    # Sin búfer ni timeouts prematuros para transmisión continua sin congelamiento
    location /api/v1/camara/stream {
        proxy_pass http://backend_servidor;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # 3. Documentación interactiva de la API
    location /docs {
        proxy_pass http://backend_servidor;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /redoc {
        proxy_pass http://backend_servidor;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /openapi.json {
        proxy_pass http://backend_servidor;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # 4. Enrutamiento del Frontend (Next.js Dashboard)
    location / {
        proxy_pass http://frontend_servidor;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache_bypass $http_upgrade;
    }
}

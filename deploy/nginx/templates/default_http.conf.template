# Configuración de Nginx para Tlalixmati en Modo HTTP o Cloudflare Flexible SSL

upstream frontend_servidor {
    server web:3000;
    keepalive 32;
}

upstream backend_servidor {
    server api:8000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME} localhost;

    client_max_body_size 30M;

    # Desafío ACME para Certbot
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # API Backend
    location /api/ {
        proxy_pass http://backend_servidor;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Streaming de cámara sin búfer
    location /api/v1/camara/stream {
        proxy_pass http://backend_servidor;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Swagger / Docs
    location /docs {
        proxy_pass http://backend_servidor;
        proxy_set_header Host $host;
    }
    location /openapi.json {
        proxy_pass http://backend_servidor;
        proxy_set_header Host $host;
    }

    # Frontend Next.js
    location / {
        proxy_pass http://frontend_servidor;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# ==============================================================================
# TLALIXMATI - CONFIGURACIÓN DE PRODUCCIÓN (DOMINIO WEB PÚBLICO)
# ==============================================================================

# 1. Dominio Web Público
# Nombre de dominio o subdominio registrado para la plataforma
DOMAIN_NAME=ejemplo.tudominio.com

# 2. URLs de Producción (utilizan HTTPS y el dominio configurado)
API_URL=https://ejemplo.tudominio.com
WEB_URL=https://ejemplo.tudominio.com

# 3. Base de Datos Cloud (Supabase)
SUPABASE_URL=https://dkgrgzokywgvylysxell.supabase.co
SUPABASE_KEY=tu_clave_anon_supabase
DATABASE_URL=postgresql://postgres.dkgrgzokywgvylysxell:tu_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# 4. Seguridad y Autenticación
# Secreto para firmar cookies de sesión (generar con python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=tu_secreto_criptografico_de_32_caracteres_o_mas

# Hash bcrypt de la contraseña única del sistema
PASSWORD_HASH=tu_hash_bcrypt_aqui

# Flag para forzar cookie segura sobre HTTPS en producción
COOKIE_SECURE=true

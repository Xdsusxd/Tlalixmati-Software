# === Supabase ===
# URL de tu instancia de Supabase
# Obligatorio | Formato: https://xxxxx.supabase.co
# Se obtiene en: Supabase Dashboard > Settings > API
SUPABASE_URL=

# Clave anónima de Supabase (anon key)
# Obligatorio | Formato: eyJhbG...
# Se obtiene en: Supabase Dashboard > Settings > API > anon public
SUPABASE_KEY=

# URL de conexión directa a PostgreSQL
# Obligatorio | Formato: postgresql://usuario:contraseña@host:puerto/basededatos
# Se obtiene en: Supabase Dashboard > Settings > Database
DATABASE_URL=

# === URLs de Servicios ===
# URL base de la API (FastAPI)
# Obligatorio | Formato: http://localhost:8000
API_URL=http://localhost:8000

# URL base del frontend (Next.js)
# Obligatorio | Formato: http://localhost:3000
WEB_URL=http://localhost:3000

# === Seguridad ===
# Secreto para firmar cookies de sesión
# Obligatorio | Formato: cadena aleatoria de al menos 32 caracteres
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Hash de la contraseña global de acceso
# Obligatorio | Formato: hash bcrypt
# Generar con: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('tu_contraseña'))"
# NUNCA guardar la contraseña en texto plano
PASSWORD_HASH=
